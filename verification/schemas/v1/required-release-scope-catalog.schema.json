{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rolefox:schema:required-release-scope-catalog:v1",
  "title": "RoleFox Required Release Scope Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_version",
    "canonicalization",
    "catalog_digest",
    "status",
    "compiled_from",
    "review",
    "scopes"
  ],
  "properties": {
    "schema_version": {
      "const": "rolefox.required-release-scopes.v1"
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "canonicalization": {
      "const": "rolefox-canonical-digest-v1"
    },
    "catalog_digest": {
      "$ref": "#/$defs/digest"
    },
    "status": {
      "enum": [
        "PROPOSED_PENDING_INDEPENDENT_REVIEW",
        "PROPOSED_PENDING_MAINTAINER_DECISION",
        "ACCEPTED",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "compiled_from": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryPath"
      }
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/scope"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ACCEPTED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "review": {
            "$ref": "#/$defs/completedReview"
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000\\\\]+$"
    },
    "identity": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^[^\\s]+$"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signed_payload_digest",
        "reviewed_by",
        "reviewed_at",
        "approval_proof_digest",
        "approver_role_version"
      ],
      "properties": {
        "signed_payload_digest": {
          "$ref": "#/$defs/digest"
        },
        "reviewed_by": {
          "oneOf": [
            {
              "$ref": "#/$defs/identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewed_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "approval_proof_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "approver_role_version": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "completedReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signed_payload_digest",
        "reviewed_by",
        "reviewed_at",
        "approval_proof_digest",
        "approver_role_version"
      ],
      "properties": {
        "signed_payload_digest": {
          "$ref": "#/$defs/digest"
        },
        "reviewed_by": {
          "$ref": "#/$defs/identity"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "approval_proof_digest": {
          "$ref": "#/$defs/digest"
        },
        "approver_role_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id",
        "capability",
        "scope_effect",
        "channel_role",
        "execution_class",
        "release_requirement",
        "minimum_mode",
        "maximum_mode",
        "reads_real_data",
        "performs_real_mutation",
        "fallback_allowed",
        "required_gate_ids"
      ],
      "properties": {
        "scope_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,127}$"
        },
        "capability": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,127}$"
        },
        "scope_effect": {
          "enum": [
            "READ",
            "BUSINESS_OUTBOUND_MUTATION",
            "SAFETY_CONTROL_MUTATION",
            "JOINED_RELEASE"
          ]
        },
        "channel_role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,127}$"
        },
        "execution_class": {
          "enum": [
            "READ_ONLY",
            "BUSINESS_MODE",
            "SAFETY_CONTROL_ONLY",
            "JOINED_RELEASE"
          ]
        },
        "release_requirement": {
          "enum": [
            "REQUIRED",
            "CONDITIONAL_IF_ENABLED_OR_L3",
            "REQUIRED_LIVE_OR_ACCEPTED_FALLBACK",
            "CONDITIONAL_IF_SUPPORTED_AND_DELETION_REQUESTED"
          ]
        },
        "minimum_mode": {
          "enum": [
            "READ_ONLY",
            "DRY_RUN",
            "PRE_L2_SHADOW",
            "L2",
            "L3",
            null
          ]
        },
        "maximum_mode": {
          "enum": [
            "READ_ONLY",
            "DRY_RUN",
            "PRE_L2_SHADOW",
            "L2",
            "L3",
            null
          ]
        },
        "reads_real_data": {
          "type": "boolean"
        },
        "performs_real_mutation": {
          "type": "boolean"
        },
        "fallback_allowed": {
          "type": "boolean"
        },
        "fallback_policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "required_gate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "fallback_allowed": {
                "const": true
              }
            },
            "required": [
              "fallback_allowed"
            ]
          },
          "then": {
            "required": [
              "fallback_policy"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "execution_class": {
                "const": "READ_ONLY"
              }
            },
            "required": [
              "execution_class"
            ]
          },
          "then": {
            "properties": {
              "scope_effect": {
                "const": "READ"
              },
              "minimum_mode": {
                "const": "READ_ONLY"
              },
              "maximum_mode": {
                "const": "READ_ONLY"
              },
              "performs_real_mutation": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution_class": {
                "const": "BUSINESS_MODE"
              }
            },
            "required": [
              "execution_class"
            ]
          },
          "then": {
            "properties": {
              "scope_effect": {
                "const": "BUSINESS_OUTBOUND_MUTATION"
              },
              "minimum_mode": {
                "const": "L2"
              },
              "maximum_mode": {
                "const": "L3"
              },
              "performs_real_mutation": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution_class": {
                "const": "SAFETY_CONTROL_ONLY"
              }
            },
            "required": [
              "execution_class"
            ]
          },
          "then": {
            "properties": {
              "scope_effect": {
                "const": "SAFETY_CONTROL_MUTATION"
              },
              "minimum_mode": {
                "type": "null"
              },
              "maximum_mode": {
                "type": "null"
              },
              "performs_real_mutation": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution_class": {
                "const": "JOINED_RELEASE"
              }
            },
            "required": [
              "execution_class"
            ]
          },
          "then": {
            "properties": {
              "scope_effect": {
                "const": "JOINED_RELEASE"
              },
              "minimum_mode": {
                "type": "null"
              },
              "maximum_mode": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
