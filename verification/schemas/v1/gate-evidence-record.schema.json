{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rolefox:schema:gate-evidence-record:v1",
  "title": "RoleFox Gate Evidence Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "record_digest",
    "gate_id",
    "scope_id",
    "criteria_version",
    "criterion_refs",
    "previous",
    "result",
    "lifecycle_state",
    "reason_codes",
    "candidate_artifact_kind",
    "candidate_artifact_digest",
    "verification_toolchain_digest",
    "candidate_scope_manifest_ref",
    "spec_manifest_ref",
    "required_release_scope_catalog_ref",
    "research_protocol_ref",
    "evidence_manifest_refs",
    "runtime_binding_manifest_refs",
    "submitted_by",
    "submitted_at",
    "approved_by",
    "approved_at",
    "approver_role_version",
    "approval_payload_digest",
    "approval_proof_digest",
    "decided_at"
  ],
  "properties": {
    "schema_version": {
      "const": "rolefox.gate-evidence-record.v1"
    },
    "record_id": {
      "type": "string",
      "pattern": "^gate_[0-9a-f]{64}$"
    },
    "record_digest": {
      "$ref": "#/$defs/digest"
    },
    "gate_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
    },
    "scope_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,127}$"
    },
    "criteria_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "criterion_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{2,127}$"
      }
    },
    "previous": {
      "oneOf": [
        {
          "$ref": "#/$defs/gateRecordRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "enum": [
        "PASS",
        "ACCEPTED_FALLBACK",
        "FAIL",
        "BLOCKED"
      ]
    },
    "lifecycle_state": {
      "enum": [
        "BLOCKED_NOT_STARTED",
        "READY_FOR_REVIEW",
        "DECIDED",
        "INVALIDATED"
      ]
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
      }
    },
    "candidate_artifact_kind": {
      "enum": [
        "SPEC_OR_EXPERIMENT",
        "BUILD"
      ]
    },
    "candidate_artifact_digest": {
      "$ref": "#/$defs/digest"
    },
    "verification_toolchain_digest": {
      "$ref": "#/$defs/digest"
    },
    "candidate_scope_manifest_ref": {
      "$ref": "#/$defs/candidateScopeRef"
    },
    "spec_manifest_ref": {
      "$ref": "#/$defs/specManifestRef"
    },
    "required_release_scope_catalog_ref": {
      "$ref": "#/$defs/catalogRef"
    },
    "research_protocol_ref": {
      "$ref": "#/$defs/protocolRef"
    },
    "evidence_manifest_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidenceRef"
      }
    },
    "runtime_binding_manifest_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/runtimeBindingRef"
      }
    },
    "predecessor_gate_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/gateRecordRef"
      }
    },
    "not_before": {
      "type": "string",
      "format": "date-time"
    },
    "submitted_by": {
      "$ref": "#/$defs/identity"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "oneOf": [
        {
          "$ref": "#/$defs/identity"
        },
        {
          "type": "null"
        }
      ]
    },
    "approved_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "approver_role_version": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "approval_payload_digest": {
      "$ref": "#/$defs/digest"
    },
    "approval_proof_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "enum": [
              "FAIL",
              "BLOCKED"
            ]
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "BLOCKED"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "lifecycle_state": {
            "const": "BLOCKED_NOT_STARTED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "enum": [
              "PASS",
              "ACCEPTED_FALLBACK",
              "FAIL"
            ]
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "lifecycle_state": {
            "const": "DECIDED"
          },
          "evidence_manifest_refs": {
            "type": "array",
            "minItems": 1
          },
          "approved_by": {
            "$ref": "#/$defs/identity"
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          },
          "approver_role_version": {
            "type": "string",
            "minLength": 1
          },
          "approval_proof_digest": {
            "$ref": "#/$defs/digest"
          },
          "approval_payload_digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "candidate_artifact_kind": {
            "const": "SPEC_OR_EXPERIMENT"
          }
        },
        "required": [
          "candidate_artifact_kind"
        ]
      },
      "then": {
        "properties": {
          "runtime_binding_manifest_refs": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^[^\\s]+$"
    },
    "gateRecordRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "record_digest"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^gate_[0-9a-f]{64}$"
        },
        "record_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "candidateScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_scope_manifest_id",
        "manifest_digest"
      ],
      "properties": {
        "candidate_scope_manifest_id": {
          "type": "string",
          "pattern": "^candidate_[0-9a-f]{64}$"
        },
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "specManifestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_digest",
        "normative_set_digest"
      ],
      "properties": {
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "normative_set_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "catalogRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_digest"
      ],
      "properties": {
        "catalog_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "protocolRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_digest"
      ],
      "properties": {
        "protocol_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "manifest_digest",
        "record_digest"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^ev_[0-9a-f]{64}$"
        },
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "record_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "runtimeBindingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_binding_manifest_id",
        "manifest_digest"
      ],
      "properties": {
        "runtime_binding_manifest_id": {
          "type": "string",
          "pattern": "^binding_[0-9a-f]{24,64}$"
        },
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
