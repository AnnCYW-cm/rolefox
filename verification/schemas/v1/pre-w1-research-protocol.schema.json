{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rolefox:schema:pre-w1-research-protocol:v1",
  "title": "RoleFox Pre-W1 Research Protocol v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "canonicalization",
    "status",
    "approval",
    "collection_guard",
    "privacy",
    "cohorts",
    "rules_replay",
    "required_outputs",
    "gate_id",
    "failure_state",
    "protocol_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "rolefox.pre-w1-research-protocol.v1"
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "canonicalization": {
      "const": "rolefox-canonical-digest-v1"
    },
    "status": {
      "enum": [
        "DRAFT_PENDING_PRODUCT_OWNER_APPROVAL",
        "APPROVED"
      ]
    },
    "approval": {
      "$ref": "#/$defs/approval"
    },
    "collection_guard": {
      "const": "NO_RECRUITMENT_OR_EVIDENCE_COLLECTION_BEFORE_APPROVAL"
    },
    "privacy": {
      "$ref": "#/$defs/privacy"
    },
    "cohorts": {
      "$ref": "#/$defs/cohorts"
    },
    "rules_replay": {
      "$ref": "#/$defs/rulesReplay"
    },
    "required_outputs": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "DEIDENTIFIED_PAIN_INTERVIEW_EVIDENCE",
          "DEIDENTIFIED_TARGET_CHANNEL_ELIGIBILITY_EVIDENCE",
          "FROZEN_PER_PARTICIPANT_JOB_DATASET_DIGESTS",
          "RULE_REPLAY_MEASUREMENTS",
          "COHORT_DENOMINATOR_AND_EXCLUSION_SUMMARY",
          "INDEPENDENT_GATE_DECISION_AND_APPROVAL_PROOF"
        ]
      }
    },
    "gate_id": {
      "const": "PRE_W1_PROBLEM_RULES"
    },
    "failure_state": {
      "const": "BLOCKED_NOT_STARTED"
    },
    "protocol_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "APPROVED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approval": {
            "$ref": "#/$defs/approved"
          }
        }
      },
      "else": {
        "properties": {
          "approval": {
            "$ref": "#/$defs/pendingApproval"
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^[^\\s]+$"
    },
    "nullableIdentity": {
      "oneOf": [
        {
          "$ref": "#/$defs/identity"
        },
        {
          "type": "null"
        }
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signed_payload_digest",
        "approved_by",
        "approved_at",
        "approver_role_version",
        "approval_proof_digest"
      ],
      "properties": {
        "signed_payload_digest": {
          "$ref": "#/$defs/digest"
        },
        "approved_by": {
          "$ref": "#/$defs/nullableIdentity"
        },
        "approved_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "approver_role_version": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "approval_proof_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "pendingApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signed_payload_digest",
        "approved_by",
        "approved_at",
        "approver_role_version",
        "approval_proof_digest"
      ],
      "properties": {
        "signed_payload_digest": {
          "$ref": "#/$defs/digest"
        },
        "approved_by": {
          "type": "null"
        },
        "approved_at": {
          "type": "null"
        },
        "approver_role_version": {
          "type": "null"
        },
        "approval_proof_digest": {
          "type": "null"
        }
      }
    },
    "approved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signed_payload_digest",
        "approved_by",
        "approved_at",
        "approver_role_version",
        "approval_proof_digest"
      ],
      "properties": {
        "signed_payload_digest": {
          "$ref": "#/$defs/digest"
        },
        "approved_by": {
          "$ref": "#/$defs/identity"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "approver_role_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "approval_proof_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_repository_content",
        "raw_interviews_and_mappings",
        "participant_identifier",
        "forbidden_public_fields"
      ],
      "properties": {
        "public_repository_content": {
          "const": "DEIDENTIFIED_MANIFESTS_AND_DIGESTS_ONLY"
        },
        "raw_interviews_and_mappings": {
          "const": "CONTROLLED_ARTIFACT_STORE_ONLY"
        },
        "participant_identifier": {
          "enum": [
            "RANDOM_COHORT_LOCAL_SURROGATE",
            "DOMAIN_SEPARATED_HMAC_SURROGATE"
          ]
        },
        "forbidden_public_fields": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "cohorts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pain_interviews",
        "target_channel_feasibility"
      ],
      "properties": {
        "pain_interviews": {
          "$ref": "#/$defs/painInterviews"
        },
        "target_channel_feasibility": {
          "$ref": "#/$defs/channelFeasibility"
        }
      }
    },
    "painInterviews": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_minimum",
        "target_maximum",
        "qualification_window",
        "pass_numerator_minimum",
        "pass_criteria"
      ],
      "properties": {
        "target_minimum": {
          "type": "integer",
          "minimum": 1
        },
        "target_maximum": {
          "type": "integer",
          "minimum": 1
        },
        "qualification_window": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "pass_numerator_minimum": {
          "type": "integer",
          "minimum": 1
        },
        "pass_criteria": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "opportunities_per_week_minimum",
            "repetitive_work_rank_maximum"
          ],
          "properties": {
            "opportunities_per_week_minimum": {
              "type": "integer",
              "minimum": 1
            },
            "repetitive_work_rank_maximum": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "channelFeasibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_n_minimum",
        "eligibility_all_of",
        "counting_rule"
      ],
      "properties": {
        "eligible_n_minimum": {
          "type": "integer",
          "minimum": 1
        },
        "eligibility_all_of": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "counting_rule": {
          "const": "SEPARATE_DENOMINATOR_FROM_PAIN_INTERVIEWS"
        }
      }
    },
    "rulesReplay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participants_minimum",
        "participant_must_pass_pain_threshold",
        "jobs_per_participant",
        "dataset_freeze_before_replay",
        "pass_criteria"
      ],
      "properties": {
        "participants_minimum": {
          "type": "integer",
          "minimum": 1
        },
        "participant_must_pass_pain_threshold": {
          "type": "boolean"
        },
        "jobs_per_participant": {
          "type": "integer",
          "minimum": 1
        },
        "dataset_freeze_before_replay": {
          "type": "boolean"
        },
        "pass_criteria": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "explicit_rejection_reasons_covered",
            "remaining_ambiguity"
          ],
          "properties": {
            "explicit_rejection_reasons_covered": {
              "enum": [
                "ALL",
                "PARTIAL",
                "NONE",
                "UNKNOWN"
              ]
            },
            "remaining_ambiguity": {
              "enum": [
                "FINITE_EXCEPTION_CATEGORIES",
                "UNBOUNDED",
                "UNKNOWN"
              ]
            }
          }
        }
      }
    }
  }
}
