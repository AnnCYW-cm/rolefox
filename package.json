{
  "name": "rolefox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A policy-governed, open-source job-search agent from goals to booked interviews.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "pnpm --filter @rolefox/web dev",
    "dev:all": "pnpm -r --parallel --if-present dev",
    "docs:check": "node scripts/validate-uml.mjs",
    "verification:bootstrap": "node scripts/verification/bootstrap-pre-w1.mjs",
    "verification:check": "node scripts/verification/check-pre-w1.mjs",
    "verification:ready": "node scripts/verification/check-pre-w1.mjs --require-pre-w1-pass",
    "verification:evidence": "node scripts/verification/append-evidence.mjs",
    "verification:gate": "node scripts/verification/append-gate.mjs",
    "verification:checkpoint": "node scripts/verification/write-checkpoint.mjs",
    "verification:test": "node --test scripts/verification/test/*.test.mjs",
    "build:packages": "tsc -b packages/domain packages/policy packages/connector-sdk packages/ai-provider apps/worker apps/runner",
    "build": "pnpm build:packages && pnpm --filter @rolefox/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm build:packages && pnpm --filter @rolefox/web typecheck",
    "test": "vitest run && pnpm verification:test",
    "check": "pnpm docs:check && pnpm verification:check && pnpm lint && pnpm typecheck && pnpm --filter @rolefox/web build && pnpm test"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "jsdom": "22.1.0",
    "mermaid": "11.17.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
